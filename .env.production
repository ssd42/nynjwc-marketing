# Production env — loaded automatically by `npm run build` / `vite build`.
#
# Anything prefixed VITE_* is PUBLIC: it gets inlined into the static JS
# served from GitHub Pages. Public URLs only — never secrets.
#
# VITE_API_BASE_URL is the backend the waitlist form POSTs to
# (`${VITE_API_BASE_URL}/v1/waitlist`). Leave empty to disable the network
# call and fall back to the PostHog event only.
#
# 🚨 Must match the backend's deployed hostname, and that hostname must be
#    in the backend's CORS_ALLOW_ORIGINS allowlist for the browser POST to
#    succeed.

# TODO: confirm this matches the real prod API hostname before deploying.
VITE_API_BASE_URL=https://api.nynjwc.com
